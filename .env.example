# Copy this file to .env and fill in what you need. .env is git-ignored.

# --- Login (optional) ---------------------------------------------------
# Leave these blank to log in by hand in the browser window on the first run
# (recommended). Your session is saved in PROFILE_DIR so later runs skip login.
X_USERNAME=
X_PASSWORD=

# Optional, opt-in: the secret key of your authenticator app (the text version
# of the QR code). Lets the script generate 2FA codes itself. Storing this next
# to your password weakens 2FA. Leave blank and you'll be asked for the code.
X_TOTP_SECRET=

# --- Mute settings ------------------------------------------------------
# How long each mute lasts: forever (shown as "Until you unmute the word") | 24h | 7d | 30d
MUTE_DURATION=30d
# Where muting applies (true/false). Keep both on for spoiler protection.
MUTE_HOME_TIMELINE=true
MUTE_NOTIFICATIONS=true
# Whose notifications to mute: anyone | not_following
MUTE_FROM=anyone

# --- Script settings ----------------------------------------------------
KEYWORDS_FILE=keywords.txt
PROFILE_DIR=.browser-profile
# Seconds to wait between keywords (a random value in this range).
DELAY_MIN=2
DELAY_MAX=5
