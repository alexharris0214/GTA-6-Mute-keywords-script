# Copy this file to .env to change settings (setup does this for you).
# .env is git-ignored. No X login details are needed: the script works in
# your normal browser, where you're already logged in.

# How long each mute lasts: 30d | 7d | 24h | forever
# (forever is shown on X as "Until you unmute the word")
MUTE_DURATION=30d

KEYWORDS_FILE=keywords.txt

# Seconds to wait for X pages to load. Raise it if your connection is slow
# and keywords show as NOT SAVED.
PAGE_WAIT=4

# Random pause between keywords, in seconds.
DELAY_MIN=1
DELAY_MAX=3
